NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (MySQL / MariaDB). Required on Railway.
# Local WAMP: mysql://root@localhost:3306/bs_app
# Railway MySQL plugin usually injects MYSQL_* vars — set DATABASE_URL from them, e.g.:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root@localhost:3306/bs_app

# Auth — REQUIRED in production (comma-separated API keys). Never commit real keys.
API_KEYS=
REQUIRE_AUTH=false

# Web UI users (JSON array). Used to seed data/web-users.json on first boot.
# WEB_USERS=[{"email":"you@company.com","password":"change-me","name":"Ops"}]
WEB_USERS=

# Optional durable path for web-users.json (attach a Railway volume here).
DATA_DIR=

# CORS — comma-separated origins for cross-site API use.
# Same-origin web UI on Railway does not need this.
CORS_ORIGINS=

# Trust X-Forwarded-* (auto-enabled in production / on Railway).
TRUST_PROXY=false

# Upload / download limits (25 MiB default)
MAX_UPLOAD_BYTES=26214400
MAX_DOWNLOAD_BYTES=26214400
MAX_SPREADSHEET_BYTES=26214400
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=40000000
MAX_PROCESSING_TIME_MS=180000
OCR_TIMEOUT_MS=120000
MAX_CONCURRENT_DOCUMENTS=2

UPLOAD_DIR=./uploads
DOCUMENT_RETENTION_HOURS=0
RETAIN_TEMP_FILES=false

# Optional host allowlist (comma-separated). Empty = any public host after SSRF checks.
ALLOWED_URL_HOSTS=

# Remote fetch controls
URL_CONNECT_TIMEOUT_MS=10000
URL_DOWNLOAD_TIMEOUT_MS=60000
URL_MAX_REDIRECTS=3

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_EXTRACT_MAX=10

# Test-only loopback downloads (ignored unless NODE_ENV=test)
ALLOW_LOOPBACK_FOR_TESTS=false
